<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Yaklaşık konum yeterli; hassas konum isteğe bağlı (Android 12+ kullanıcı "Yaklaşık"ı seçebilir).
        Hassas konum sadece cihazda, mahalle adı ve en yakın istasyon için kullanılır; dışarıya giden
        koordinatlar yaklaşık 1 km'ye yuvarlanır. Konum sadece uygulama açıkken alınır.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".CommuneSkyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CommuneSky">
        <!-- Performans ölçüm araçlarının (Macrobenchmark) release sürümünü profilleyebilmesi için. -->
        <profileable android:shell="true" tools:targetApi="29" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CommuneSky.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Ana ekran widget'ları: 9 widget, her birinde birden fazla stil. Alıcı adları 1.2'den
            korunuyor (Small = Küçük, Medium = Saatlik, Large = Haftalık); eski widget'lar silinmez.
        -->
        <receiver
            android:name=".widget.HomeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kind_home">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_home" />
        </receiver>
        <receiver
            android:name=".widget.ClockWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kind_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_clock" />
        </receiver>
        <receiver
            android:name=".widget.MediumWeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kind_hourly">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_hourly" />
        </receiver>
        <receiver
            android:name=".widget.LargeWeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kind_weekly">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_weekly" />
        </receiver>
        <receiver
            android:name=".widget.SmallWeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kind_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_small" />
        </receiver>
        <receiver
            android:name=".widget.TextWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kind_text">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_text" />
        </receiver>
        <receiver
            android:name=".widget.PlacesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kind_places">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_places" />
        </receiver>
        <receiver
            android:name=".widget.PrecipitationWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kind_precipitation">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_precipitation" />
        </receiver>
        <receiver
            android:name=".widget.DetailsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_kind_details">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_details" />
        </receiver>

        <!-- Widget ayar ekranı: widget eklenirken ve "Widget'ı düzenle" ile açılır. -->
        <activity
            android:name=".widget.config.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_config_title"
            android:taskAffinity=""
            android:theme="@style/Theme.CommuneSky">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Uygulama içinden seçilen dil: Android 12 ve altında AppCompat bu servisle saklar. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- WorkManager'ı Hilt ile kendimiz başlatıyoruz (CommuneSkyApp); otomatik başlatmayı kapat. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>

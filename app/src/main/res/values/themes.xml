<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CommuneSky" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
        Açılış ekranı (Android 12+ sistem açılış ekranı; eski sürümlerde aynı görünüm taklit edilir).
        Uygulama hazır olunca otomatik olarak Theme.CommuneSky'a geçilir.
    -->
    <style name="Theme.CommuneSky.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CommuneSky</item>
    </style>
</resources>

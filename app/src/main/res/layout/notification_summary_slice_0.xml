<?xml version="1.0" encoding="utf-8"?>
<!-- Özetin bir gün dilimi: ad, simge, sıcaklık, yağış ihtimali. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slice_0"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:layout_weight="1"
    android:background="@drawable/notification_slice_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/slice_0_label"
        style="@style/TextAppearance.Compat.Notification.Info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/slice_0_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/slice_0_temperature"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/slice_0_chance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF2F80ED"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_preview_bg_dark" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingVertical="10dp" tools:ignore="HardcodedText,ContentDescription">
        <LinearLayout android:layout_width="128dp" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yayla" android:textColor="#FFB5E3FF" android:textSize="13sp" android:fontFamily="sans-serif" />

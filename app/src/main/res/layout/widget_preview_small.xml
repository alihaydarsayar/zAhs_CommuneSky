            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17°" android:textColor="#FFFFFFFF" android:textSize="54sp" android:fontFamily="sans-serif-light" android:layout_weight="1" android:gravity="center_vertical" />

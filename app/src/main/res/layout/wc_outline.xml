<?xml version="1.0" encoding="utf-8"?>
<!--
    Ici bos rakam, tek TextClock: uygulamanin cizgi rakamli yazi tipi. Yalnizca Android 11 ve oncesinde
    kullanilir; Android 12+ launcher'i widget'larda uygulamanin yazi tipini yuklemez (bkz. wc_hollow_*).
-->
<TextClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:format12Hour="mm"
    android:format24Hour="mm"
    android:paddingHorizontal="2dp"
    android:fontFamily="@font/commune_digits_outline"
    android:fontFeatureSettings="tnum"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="#FFFFFFFF" />

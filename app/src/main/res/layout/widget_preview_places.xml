<?xml version="1.0" encoding="utf-8"?>
<!-- Widget seçicide gösterilen önizleme (Android 12+): Yerlerim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_preview_bg_sky" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:paddingVertical="8dp" tools:ignore="HardcodedText,ContentDescription">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yayla" android:textColor="#FFFFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_wl_clear_night" android:tint="#FFFDE68A" android:layout_marginEnd="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15°" android:textColor="#FFFFFFFF" android:textSize="26sp" android:fontFamily="sans-serif-light" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18° / 6°" android:textColor="#BFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginVertical="8dp" android:background="#24FFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kadıköy" android:textColor="#FFFFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_wl_partly_cloudy_night" android:tint="#FFFFFFFF" android:layout_marginEnd="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16°" android:textColor="#FFFFFFFF" android:textSize="26sp" android:fontFamily="sans-serif-light" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19° / 11°" android:textColor="#BFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginVertical="8dp" android:background="#24FFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Atakum" android:textColor="#FFFFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_wl_rain" android:tint="#FFB5E3FF" android:layout_marginEnd="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12°" android:textColor="#FFFFFFFF" android:textSize="26sp" android:fontFamily="sans-serif-light" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16° / 9°" android:textColor="#BFFFFFFF" android:textSize="12sp" android:fontFamily="sans-serif" />
        </LinearLayout>
</LinearLayout>

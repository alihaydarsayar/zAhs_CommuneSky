<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8–11 (API 26–30) yedekleme kuralları; Android 12+ data_extraction_rules.xml'i okur. Liste aynıdır:
    yalnız ayarlar, widget ayarları, kayıtlı yerler, dil ve saat biçimi. Çalışma durumu ("gönderildi" işaretleri,
    deneme ve alarm kayıtları, önbellekler, veritabanı) yedeğe girmez.
-->
<full-backup-content>
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="file" path="datastore/widgets.preferences_pb" />
    <include domain="file" path="backup/places.json" />
    <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    <include domain="sharedpref" path="widget_language.xml" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Isinsal saatin saniye yelpazesi (AnalogClock saniye kolu). Ondeki kenar tam dolu, geriye dogru
    36 derecede (alti cizgi) saydama iner. Widget'in kosegeninden buyuk cizilir; sablonun
    deliklerinden gorunur. Resim degil sekil: bellekte yer tutmaz.
    3 derece one kaydirildi: o anki saniyenin cizgisi tam parlak olsun.
    Gradyanin orta rengi 0,9 konumunda (centerY); bu ayni zamanda gradyanin merkezini seklin
    yuksekliginin %90'ina tasidigi icin sekil 500 dp yuksek tutulur: merkez tam ortaya (450 dp) duser.
-->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="-87"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toDegrees="-87">
    <layer-list>
        <item android:bottom="400dp">
            <shape android:shape="rectangle">
                <size android:width="900dp" android:height="500dp" />
                <gradient
                    android:centerColor="#00FFFFFF"
                    android:centerY="0.9"
                    android:endColor="#FFFFFFFF"
                    android:startColor="#00FFFFFF"
                    android:type="sweep" />
            </shape>
        </item>
    </layer-list>
</rotate>

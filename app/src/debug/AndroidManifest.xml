<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Yalnız debug sürümünde: görsel çekimleri için nötr duvar kâğıdı koyan yardımcı test (ReadmeWallpaperTest). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application>
        <!-- Yalnız debug sürümünde: adb ile sahte ağ arızası (bkz. DebugNetwork). Release'de yoktur. -->
        <receiver
            android:name=".debug.NetworkFaultReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.alihaydarsayar.communesky.debug.FAULT" />
            </intent-filter>
        </receiver>
        <!-- Yalnız debug sürümünde: README ve mağaza görselleri için örnek hava durumu (bkz. DemoWeather). Release'de yoktur. -->
        <receiver
            android:name=".debug.DemoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.alihaydarsayar.communesky.debug.DEMO" />
            </intent-filter>
        </receiver>
        <!-- Yalnız debug sürümünde: doğruluk kayıtlarını (CSV) paylaş menüsüne vermek için. Release'de yoktur. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.debugexport"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/debug_export_paths" />
        </provider>
    </application>

</manifest>
